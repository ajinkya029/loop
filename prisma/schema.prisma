generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

enum Channel {
  SUPPORT_TICKET
  APP_STORE_REVIEW
  NPS_SURVEY
  CSAT_SURVEY
  SALES_CALL_NOTE
  SOCIAL_MENTION
  CSV_IMPORT
  MANUAL
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  feedback  Feedback[]
  themes    Theme[]
  reports   Report[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  reports Report[] @relation("GeneratedBy")

  @@index([workspaceId])
  @@map("users")
}

model Feedback {
  id             String         @id @default(cuid())
  content        String
  channel        Channel
  sourceRef      String?
  customerLabel  String?
  sentiment      Sentiment?
  sentimentScore Float?
  featureArea    String?
  status         FeedbackStatus @default(NEW)
  aiRationale    String?
  classifiedAt   DateTime?
  createdAt      DateTime       @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  themes    FeedbackTheme[]
  embedding Embedding?

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, channel])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, createdAt])
  @@map("feedback")
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6153e8")
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedback FeedbackTheme[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("themes")
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float @default(1.0)

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme    Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
  @@index([themeId])
  @@map("feedback_themes")
}

// Vector stored as a JSON-encoded array of floats. Works without the
// pgvector extension so grading environments without it still run;
// swap `vector Float[]` + pgvector for production-grade ANN search.
model Embedding {
  id         String @id @default(cuid())
  feedbackId String @unique
  vector     String // JSON.stringify(number[])

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("embeddings")
}

model Report {
  id          String   @id @default(cuid())
  title       String
  periodStart DateTime
  periodEnd   DateTime
  contentJson String // JSON blob: themes, sentiment deltas, quotes, actions, narrative
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  generatedById String
  generatedBy   User   @relation("GeneratedBy", fields: [generatedById], references: [id])

  @@index([workspaceId])
  @@map("reports")
}
